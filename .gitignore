# ── MORE-harvest — local-only repo ──
# Tracks the pipeline CODE/DOCS/CONFIG. Excludes API keys, router databases,
# run outputs, and third-party article content — none of which must enter git.

# API keys: one-line files beside the scripts that read them
# (harvest_openalex.py, fetch_tei.py, fetch_vor_pdfs.py, fetch_router.py).
# MUST NEVER be committed.
/openalex_key.txt
/springer_key.txt
/elsevier_key.txt
*_key.txt
.env

# Router databases: rebuilt from ingest_log.json, so never committed.
# DuckDB may also leave a write-ahead log next to the database.
/works_*.duckdb
/works_*.duckdb.wal

# Operational state: the durable ingest record and the audit ledger.
# Local run history, churns per paper, never committed.
/ingest_log.json
/ingest_log.json.tmp
/audits.jsonl

# Third-party article content: fetched publisher sources and built packages.
# Regenerated by the pipeline; must not enter git.
/fetched/
/ingested/
/pilot/
/pilot2/

# Harvest data: OpenAlex pages, downloaded content, pilots and summaries.
# Everything is ignored except the one tracked sample page — and git cannot
# re-include a file whose parent directory is excluded, so the directory itself
# is re-included first.
/harvest/*
!/harvest/works_2025/
/harvest/works_2025/*
!/harvest/works_2025/page_0001.json

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Coverage data
.coverage
.coverage.*
htmlcov/
coverage.xml

# tei_pilot - files used for calibration of Workstation B
tei_pilot/

# The uv-managed environment — provisioned per machine, never committed.
# NOTE: uv.lock itself IS committed and must stay that way.
.venv/

# Vendor-specific generated agent configurations
/.claude/
/.codex/
/.agents/
/.grok/

# OS and editor noise (mirrors the workstation list)
.DS_Store
._*
~$*
*.swp
*~
Thumbs.db
ehthumbs.db
desktop.ini
.Spotlight-V100
.Trashes
